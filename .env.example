# PRODUCTION — copy to .env (used with liara.json → app "bordin")
BORDIN_ENV=production
# Internal Liara host — apps on Liara use this via panel env vars.
# From your PC, `npx prisma db push` cannot reach bordindb:3306.
# Use instead:  npm run db:push  (runs inside Liara shell automatically)
DATABASE_URL="mysql://root:PASSWORD@bordindb:3306/naughty_shannon"
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
SMS_MOCK_MODE="false"
# SMS.ir OTP panel — set true to send real login codes via SMS.ir (off by default until enabled)
# SMS_PANEL_ENABLED=true
# Store sell-coins tab on bordin.ir — set true to show "فروش سکه" in the store
# STORE_SELL_ENABLED=true
# SMS.ir — production OTP only (server-side; never expose to client)
# SMS_IR_API_KEY="your-sms-ir-api-key"
# SMS_IR_OTP_TEMPLATE_ID="220515"
# SMS_IR_OTP_PARAMETER_NAMES="OTP,CODE"
# SMS_IR_OTP_PARAMETER_NAME="OTP"  # legacy: single param only
# SMS_IR_REQUEST_TIMEOUT_MS=10000
# Fixed OTP test phones (09120000000 / 09120000001) use code 123456 — see src/shared/constants/auth.ts
ADMIN_NOTIFY_PHONE="09010558858"
DEV_MEMORY_DB="false"
NEXT_PUBLIC_APP_URL="https://bordin.ir"

# LOCAL DEV — copy to .env.local (Liara DB not reachable from your PC)
# DEV_MEMORY_DB=true
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# STAGING — see .env.staging.example and docs/STAGING.md

# football-data.org — بازی‌های واقعی کنداکتور
# ثبت‌نام: https://www.football-data.org/client/register
# endpoint: GET https://api.football-data.org/v4/matches?date=YYYY-MM-DD
# FOOTBALL_DATA_API_KEY="your-token-here"
# KANDAKATOR_RUNTIME_SYNC=true
# FOOTBALL_DATA_FETCH_TIMEOUT_MS=15000

# Zibal payment gateway (only supported provider)
# ZIBAL_MERCHANT_ID="6a37a39d85fd495b7d3a9049"
# ZIBAL_USE_LIVE_ON_STAGING=true
# PAYMENT_GATEWAY_MOCK=false
# PAYMENT_RECONCILE_INTERVAL_MS=300000