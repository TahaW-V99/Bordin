# Copy to .env.production.local for direct production DB access from your PC.
# Get the public MySQL URL from Liara panel → Databases → bordindb → Public Network.
#
# Used by:
#   npm run recover:kandakator:production  (local-db mode — skips Liara shell)
#   npm run make-admin:production
#   node scripts/grant-admin-direct.mjs
#
# Without this file, recover uses Liara shell automatically (recommended).

DATABASE_URL="mysql://root:PASSWORD@HOST:PORT/naughty_shannon"
FOOTBALL_DATA_API_KEY="your-football-data-token"
