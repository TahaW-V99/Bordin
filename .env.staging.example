# کپی کنید به .env.staging و مقادیر واقعی را بگذارید (این فایل در گیت نیست)
# دیتابیس staging — نباید با DATABASE_URL محیط production یکی باشد

BORDIN_ENV=staging
DATABASE_URL="mysql://root:PASSWORD@bordindbtest:3306/xenodochial_taussig"
JWT_SECRET="staging-only-jwt-secret-min-32-characters"
SMS_MOCK_MODE=true
# Staging keeps mock OTP — do not set SMS_IR_* here
DEV_MEMORY_DB=false
NEXT_PUBLIC_APP_URL=https://YOUR-STAGING-APP.liara.run
FIXTURE_API_KEY=your-fixture-api-key

# همگام‌سازی مستقیم از سرور — با FIXTURE_API_KEY فعال کنید
KANDAKATOR_RUNTIME_SYNC=true
FIXTURE_API_FETCH_TIMEOUT_MS=15000

# توکن ارسال داده به برنامه — باید با KANDAKATOR_SYNC_PUSH_TOKEN در GitHub یکی باشد
KANDAKATOR_SYNC_PUSH_TOKEN=your-random-push-token
# Zibal payment gateway
ZIBAL_MERCHANT_ID=6a37a39d85fd495b7d3a9049
# برای تست واقعی روی staging: ZIBAL_USE_LIVE_ON_STAGING=true و PAYMENT_GATEWAY_MOCK=false
PAYMENT_GATEWAY_MOCK=true

# ─── به‌روزرسانی خودکار ───
# گیت‌هاب Actions (پیشنهادی):
# ۱. پروژه را در GitHub push کنید
# ۲. در GitHub → Settings → Secrets → Actions این را اضافه کنید:
#    KANDAKATOR_SYNC_PUSH_TOKEN  (همان مقدار بالا)
# ۳. اختیاری: BORDIN_PUSH_URLS=https://bordintest.ir
# هر ۲۰ دقیقه صف همگام‌سازی enqueue می‌شود و سرور مستقیماً از Fixture API می‌خواند.

# همگام‌سازی دستی از کامپیوتر (فقط در صورت نیاز):
#   npm run push:kandakator:staging
