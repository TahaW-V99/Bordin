# Copy to .env.staging.local for local staging tools on your PC
# Public MySQL URL from Liara panel → Databases → bordindbtest → Public Network
# DATABASE_URL="mysql://root:PASSWORD@logan.liara.cloud:PORT/xenodochial_taussig"
#
# Use false when DATABASE_URL points at real staging MySQL (recover/sync/db-push from PC):
DEV_MEMORY_DB=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
# FIXTURE_API_KEY for local recover/sync from your PC:
#   npm run recover:kandakator:staging
#   npm run sync:kandakator:staging
