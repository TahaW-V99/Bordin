{
  "name": "bordin-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.11.0",
    "@emnapi/wasi-threads": "1.2.1"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:staging": "dotenv -e .env.staging.local -e .env.staging -- next dev --turbopack",
    "build": "prisma generate && next build",
    "build:staging": "prisma generate && dotenv -e .env.staging.local -e .env.staging -- next build",
    "start": "next start",
    "deploy:production": "node scripts/liara-deploy.mjs production",
    "deploy:production:force": "node scripts/liara-deploy.mjs production --force",
    "deploy:staging": "node scripts/liara-deploy.mjs staging",
    "deploy:both": "node scripts/liara-deploy.mjs both",
    "env:sync:staging": "node scripts/sync-staging-env.mjs",
    "env:sync:production:kandakator": "node scripts/sync-production-kandakator-env.mjs",
    "sync:kandakator:week": "tsx scripts/sync-kandakator-week.ts",
    "sync:kandakator:staging": "tsx scripts/sync-kandakator-week.ts --staging",
    "push:kandakator:staging": "tsx scripts/push-kandakator-staging.ts",
    "push:kandakator:production": "tsx scripts/push-kandakator-production.ts",
    "push:kandakator:remote": "tsx scripts/push-kandakator-remote.ts",
    "recover:kandakator:staging": "tsx scripts/recover-kandakator.ts",
    "recover:kandakator:production": "node scripts/recover-kandakator.mjs production",
    "recover:kandakator:production:shell": "liara shell --app bordin --command \"node prisma/recover-kandakator-liara.mjs\"",
    "fix:france-spain:production": "node scripts/fix-france-spain-production-liara.mjs",
    "fix:england-argentina:production": "node scripts/fix-england-argentina-production-liara.mjs",
    "rescore:predictions:production:shell": "liara shell --app bordin --command \"node prisma/rescore-predictions-liara.mjs\"",
    "cf:open:install": "npm install --prefix workers/bordin-open",
    "cf:open:deploy": "npm run deploy --prefix workers/bordin-open",
    "cf:open:deploy:staging": "npm run deploy --prefix workers/bordin-open -- --env staging",
    "cf:open:setup": "npm run cf:open:install && npm run cf:open:deploy && npm run cf:open:deploy:staging",
    "test:accuracy": "tsx src/shared/lib/prediction-accuracy.test.ts",
    "lint": "eslint",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:push": "node scripts/db-push.mjs production",
    "db:push:production": "node scripts/production-db-push.mjs",
    "db:patch:production": "liara shell --app bordin --command \"node prisma/patch-production-db.mjs\"",
    "backfill:team-competition-banners:production": "liara shell --app bordin --command \"node prisma/backfill-team-competition-banners.mjs\"",
    "repair:world-cup-banner:production": "liara shell --app bordin --command \"node prisma/repair-world-cup-banner.mjs\"",
    "fix:world-cup-banner:production": "liara shell --app bordin --command \"node prisma/fix-banner-url.mjs\"",
    "make-admin:production": "node scripts/run-make-admin-production.mjs",
    "grant-admin:direct": "node scripts/grant-admin-direct.mjs",
    "grant:production:users": "liara shell --app bordin --command \"node prisma/apply-production-user-grants.mjs\"",
    "grant:production:mohammad1": "liara shell --app bordin --command \"node prisma/grant-user-single.mjs\"",
    "announce:watch-party:production": "liara shell --app bordin --command \"node prisma/send-watch-party-announcement.mjs\"",
    "grant:production:users:push": "node scripts/push-grant-script-to-liara.mjs",
    "update:prediction:production": "liara shell --app bordin --command \"node prisma/update-daily-prediction.mjs\"",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "node scripts/db-push.mjs production && tsx prisma/seed.ts",
    "db:push:staging": "node scripts/db-push.mjs staging",
    "sync:world-cup:inspect": "npx dotenv -e .env.production.local -- node prisma/sync-world-cup-competition.mjs --inspect",
    "sync:world-cup:dry-run": "npx dotenv -e .env.production.local -- node prisma/sync-world-cup-competition.mjs --dry-run",
    "sync:world-cup:production": "npx dotenv -e .env.production.local -- node prisma/sync-world-cup-competition.mjs --apply",
    "sync:world-cup:patch-quarter": "npx dotenv -e .env.production.local -- node prisma/sync-world-cup-competition.mjs --patch-quarter",
    "repair:world-cup-knockout:inspect": "liara shell --app bordin --command \"node prisma/repair-world-cup-knockout.mjs --inspect\"",
    "repair:world-cup-knockout:production": "liara shell --app bordin --command \"node prisma/repair-world-cup-knockout.mjs --apply\"",
    "db:reset:staging": "node scripts/db-push.mjs staging --force-reset",
    "db:seed:staging": "dotenv -e .env.staging.local -e .env.staging -- tsx prisma/seed.ts",
    "db:setup:staging": "node scripts/db-push.mjs staging --force-reset && dotenv -e .env.staging.local -e .env.staging -- tsx prisma/seed.ts",
    "process:medals": "node scripts/process-leaderboard-medals.mjs",
    "setup:medal-images": "node scripts/setup-medal-images.mjs",
    "remap:medal-images": "node scripts/remap-medal-images.mjs",
    "grant:medal:dev": "tsx scripts/grant-medal-dev.ts",
    "seed:predictions:staging": "liara shell --app bordintest --command \"node scripts/seed-predictions-staging-user.mjs\"",
    "migrate:legacy-users": "node scripts/migrate-legacy-users.mjs production",
    "migrate:legacy-users:staging": "node scripts/migrate-legacy-users.mjs staging",
    "prisma": "node scripts/prisma-cli.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.2.8",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "^4.4.0-0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.17.0",
    "next": "15.5.19",
    "prisma": "^7.8.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.19",
    "tsx": "^4.22.4"
  }
}
