// Persisted sync/reconcile health — survives deploys and restarts
model KandakatorSyncRecord {
  id           String   @id @default(cuid())
  scope        String
  status       String
  source       String
  matchCount   Int      @default(0)
  settledCount Int      @default(0)
  staleCount   Int      @default(0)
  orphanCount  Int      @default(0)
  errorMessage String?  @db.Text
  durationMs   Int?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([scope, createdAt])
  @@index([createdAt])
  @@map("kandakator_sync_records")
}

// Structured lifecycle/sync audit trail
model SystemEventLog {
  id        String   @id @default(cuid())
  category  String
  entityId  String?
  payload   Json
  createdAt DateTime @default(now())

  @@index([category, createdAt])
  @@index([entityId, createdAt])
  @@map("system_event_logs")
}

model KandakatorSyncJob {
  id             String        @id @default(cuid())
  dateKey        String
  status         SyncJobStatus @default(PENDING)
  source         String
  requestedBy    String?
  attemptCount   Int           @default(0)
  maxAttempts    Int           @default(5)
  nextAttemptAt  DateTime      @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?       @db.Text
  lastFetchedAt  DateTime?
  lastWrittenAt  DateTime?
  lastVerifiedAt DateTime?
  payload        Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, nextAttemptAt])
  @@index([dateKey, status])
  @@index([createdAt])
  @@map("kandakator_sync_jobs")
}

model WatchPartyRoom {
