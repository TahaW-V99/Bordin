enum ChatRoomSlug {
  PUBLIC
  TODAY_PREDICTIONS
  TEAMS
  TEAMS_ALL
  COMPETITIONS
}

enum ChatMessageType {
  TEXT
  SYSTEM
  PREDICTION_RESULT
  DUEL_CHALLENGE
  COMPETITION_INFO
}

model ChatMessage {
  id        String          @id @default(cuid())
  roomSlug  ChatRoomSlug
  teamId    String?
  userId    String?
  type      ChatMessageType @default(TEXT)
  body      String          @db.Text
  payload   Json?
  replyToId String?
  createdAt DateTime        @default(now())

  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  team    Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  replyTo ChatMessage?  @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies ChatMessage[] @relation("ChatMessageReplies")
  reports ChatMessageReport[]
  reactions ChatReaction[]

  @@index([roomSlug, teamId, createdAt])
  @@index([roomSlug, createdAt])
  @@index([roomSlug, id])
  @@index([replyToId])
  @@map("chat_messages")
}

model ChatRoomRead {
  id         String   @id @default(cuid())
  userId     String
  roomKey    String   @db.VarChar(64)
  lastReadAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roomKey])
  @@index([userId])
  @@map("chat_room_reads")
}

model ChatMessageReport {
  id         String   @id @default(cuid())
  messageId  String
  reporterId String
  reason     String?  @db.Text
  createdAt  DateTime @default(now())

  message  ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter User        @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([messageId, reporterId])
  @@index([messageId])
  @@map("chat_message_reports")
}

model ChatReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("chat_reactions")
}

