  invitee User           @relation("WatchPartyInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([roomId, inviterId, inviteeId])
  @@index([inviteeId, dismissedAt])
  @@map("watch_party_invites")
}

